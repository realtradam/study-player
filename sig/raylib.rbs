  SKYBLUE: Rl::Color
  BLUE: Rl::Color
  DARKBLUE: Rl::Color
  PURPLE: Rl::Color
  VIOLET: Rl::Color
  DARKPURPLE: Rl::Color
  BEIGE: Rl::Color
  BROWN: Rl::Color
  DARKBROWN: Rl::Color
  WHITE: Rl::Color
  BLACK: Rl::Color
  BLANK: Rl::Color
  MAGENTA: Rl::Color
  RAYWHITE: Rl::Color
  RAYLIB_VERSION_MAJOR: Integer
  RAYLIB_VERSION_MINOR: Integer
  RAYLIB_VERSION_PATCH: Integer
  PI: Float
  RAYLIB_VERSION: String
  Quaternion: untyped  # alias for Rl::Vector4
  Texture2D: untyped  # alias for Rl::Texture
  TextureCubemap: untyped  # alias for Rl::Texture
  RenderTexture2D: untyped  # alias for Rl::RenderTexture
  Camera: untyped  # alias for Rl::Camera3D
  ModelAnimPose: untyped  # alias for Rl::Transform
end

